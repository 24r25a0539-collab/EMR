# EMR Platform Environment Configuration
# ======================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=super-secure-emr-platform-jwt-secret-key-change-in-production-2026
JWT_EXPIRES_IN=7d
ADMIN_SECRET_KEY=admin-portal-secure-key-2026

# Database (Default: SQLite for standalone zero-config dev; switch to PostgreSQL in production)
DATABASE_URL="file:../database/prisma/dev.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://emr_user:password@localhost:5432/emr_db?schema=public"

# Blockchain EVM Configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
FALLBACK_CRYPTO_LEDGER=true

# Security & Rate Limiting
MAX_LOGIN_ATTEMPTS=5
OTP_EXPIRY_MINUTES=10
SESSION_TIMEOUT_HOURS=24
